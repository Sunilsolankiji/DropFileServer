PORT=3001
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3001

# CORS - Comma-separated list of allowed origins (used in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://sunilsolankiji.github.io

# File settings
MAX_FILE_SIZE=2147483648
FILE_TTL_MS=3600000
MAX_FILES_PER_ROOM=50

# Chunk relay settings
CHUNK_SIZE=1048576
MAX_CHUNK_SIZE=4194304
MAX_INFLIGHT_CHUNKS=8
MAX_TRANSFER_BUFFER_BYTES=67108864

# Cleanup intervals (in milliseconds)
CLEANUP_INTERVAL=30000
INACTIVE_TIMEOUT=30000
